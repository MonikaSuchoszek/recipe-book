<!doctype html>
<html lang="{{ site.lang }}" data-base="{{ '/' | url }}" data-theme="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {%- set pageTitle = (title + " · " + site.name) if title and title != site.name else site.name %}
  {%- set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <script>
    // Apply the saved theme before the first paint, so there is no flash of the wrong colours
    (function () {
      var theme = "system";
      try { theme = localStorage.getItem("recipeBook.theme") || "system"; } catch (error) {}
      if (["system", "light", "dark"].indexOf(theme) < 0) theme = "system";
      document.documentElement.setAttribute("data-theme", theme);
      document.documentElement.classList.add("js");
    })();
  </script>
  <meta name="theme-color" content="#FBFAF5" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121814" media="(prefers-color-scheme: dark)">
  <link rel="preload" href="{{ '/assets/fonts/nunito-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/nunito-latin-800-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/taxonomy.css' | url }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/illustrations/favicon.svg' | url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon-32.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if recipe else 'website' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  {%- if socialImage %}
  <meta property="og:image" content="{{ socialImage.url | absoluteUrl }}">
  <meta property="og:image:width" content="{{ socialImage.width }}">
  <meta property="og:image:height" content="{{ socialImage.height }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="{{ '/' | url }}">
        <img class="brand__logo" src="{{ '/assets/illustrations/logo.svg' | url }}" alt="" width="40" height="40">
        <span class="brand__name">{{ site.name }}</span>
      </a>
      {% set navPlace = "top" %}{% include "partials/nav.njk" %}
    </div>
  </header>

  <main id="main" class="site-main" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {% set navPlace = "bottom" %}{% include "partials/nav.njk" %}

  <div class="toaster" id="toaster" aria-live="polite" aria-atomic="true"></div>

  <script type="module" src="{{ '/assets/js/theme.js' | url }}"></script>
  {%- for script in scripts %}
  <script type="module" src="{{ ('/assets/js/' + script) | url }}"></script>
  {%- endfor %}
</body>
</html>
