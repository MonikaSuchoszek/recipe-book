<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">
      <img src="{{ '/assets/illustrations/logo.svg' | url }}" alt="" width="28" height="28">
      <span>{{ site.name }}</span>
    </p>
    {#- One button cycles System → Light → Dark; CSS shows the icon for the current data-theme, so it is right before JS runs #}
    <p class="appearance needs-js">
      <span aria-hidden="true">Mode:</span>
      <button type="button" class="icon-button appearance__toggle" data-appearance aria-label="Mode: System" title="Mode: System">
        {%- icon "monitor", "appearance__icon" %}{% icon "sun", "appearance__icon" %}{% icon "moon", "appearance__icon" -%}
      </button>
    </p>
  </div>
</footer>
