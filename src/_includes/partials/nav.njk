{#- Same links twice: a top header from tablet width up, a thumb-reachable bottom bar on phones -#}
{%- set links = [
  { key: "home", label: "Home", href: "/", icon: "home" },
  { key: "search", label: "Search", href: "/search/", icon: "search" },
  { key: "planner", label: "Planner", href: "/planner/", icon: "calendar" }
] %}
<nav class="{{ 'top-nav' if navPlace == 'top' else 'tabbar' }}" aria-label="{{ 'Main' if navPlace == 'top' else 'Main (bottom)' }}">
  <ul>
    {%- for link in links %}
    <li>
      <a href="{{ link.href | url }}"{% if navKey == link.key %} aria-current="page"{% endif %}>
        <span class="nav-icon">{% icon link.icon %}</span>
        <span class="nav-label">{{ link.label }}</span>
      </a>
    </li>
    {%- endfor %}
  </ul>
</nav>
